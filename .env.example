# Notion internal integration token — create at https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The data source (collection) ID of your "Meals Log" database.
NOTION_DATA_SOURCE_ID=a3afae23-26f9-457f-9758-f8eefe468f7a

# Optional: data source ID of a "Weight Log" database (columns: Date + "Weight (lbs)").
# Create it with `node scripts/setup-weight-db.mjs`. Leave blank to hide the weight graph.
NOTION_WEIGHT_DATA_SOURCE_ID=

# Optional: IANA timezone used to decide which day is "today" (e.g. America/New_York).
# Defaults to the server's local timezone. Set this in production — Vercel runs in UTC,
# which would otherwise roll "today" over to tomorrow late in the evening.
TRACKER_TIMEZONE=
